# Copy to .env (gitignored) — never commit these. Or export them in your shell.
# Create the OAuth client in the Google Cloud Console (see BUILD_SETUP_NEXT_STEPS.md).
NBRIDGE_GOOGLE_CLIENT_ID=
NBRIDGE_GOOGLE_CLIENT_SECRET=
